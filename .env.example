# =============================================================================
# RAG Student Handbook — Environment Variables
#
# 1. Copy this file:  cp .env.example .env
# 2. Fill in every value marked  ← CHANGE THIS
# 3. Never commit the real .env to version control
# =============================================================================

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=replace-with-your-gemini-api-key   # ← CHANGE THIS

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=student_handbook
POSTGRES_PASSWORD=changeme          # ← CHANGE THIS
POSTGRES_DB=student_handbook
DATABASE_URL=postgresql://student_handbook:changeme@localhost:5433/student_handbook

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme             # ← CHANGE THIS  (min 8 chars)
NEO4J_DB=neo4j

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=student_handbook

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Embedding / LLM ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=dangvantuan/vietnamese-embedding
EMBEDDING_DIMENSION=768
LLM_MODEL=gemini-3.1-flash-lite

# ── RAG Tuning ────────────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_RESULTS=3
RETRIEVAL_RECALL_K=20
GRAPH_INGESTION_ENABLED=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# For local dev the Streamlit UI runs on 8501
CORS_ORIGINS=http://localhost:8501

# ── Streamlit client ─────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000

# ── LangSmith (optional observability) ───────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=student_handbook
