# =============================================================================
# RAG Student Handbook — Environment Variables
#
# 1. Copy this file:  cp .env.example .env
# 2. Fill in every value marked  ← CHANGE THIS
# 3. Never commit the real .env to version control
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme          # ← CHANGE THIS
POSTGRES_DB=student_handbook

# Full URL used by the backend (automatically built from the three vars above
# when running inside Docker; override only if using an external DB).
DATABASE_URL=postgresql://postgres:changeme@localhost:5433/student_handbook

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme             # ← CHANGE THIS  (min 8 chars)
NEO4J_DB=neo4j
NEO4J_URI=bolt://localhost:7687

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=student_handbook

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...               # ← CHANGE THIS
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# ── Authentication (JWT) ──────────────────────────────────────────────────────
# Generate a strong secret:  openssl rand -hex 32
JWT_SECRET_KEY=super_secret_key_please_change_in_production   # ← CHANGE THIS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash).
# In production, set this to your actual domain, e.g.:
#   CORS_ORIGINS=https://yourdomain.com
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000

# ── Email — Resend (password-reset feature) ───────────────────────────────────
# Leave empty to disable email sending (reset link will still be generated
# but not delivered).
RESEND_API_KEY=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_CLIENT_ID=       # ← CHANGE THIS (optional)

# ── Frontend ──────────────────────────────────────────────────────────────────
# When running behind nginx on port 80, all API calls go through /api (no host).
# For local dev without Docker, point at the backend directly.
NEXT_PUBLIC_API_URL=/api

# ── RAG Tuning ────────────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_RESULTS=3

# ── Redis (Cache) ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── LangSmith (Observability) ─────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=                  # ← CHANGE THIS (optional)
LANGCHAIN_PROJECT=student_handbook
